# wrangler v4 declares a `@cloudflare/workers-types@^5` peer dependency, but
# this repo deliberately pins `^4.20260702.1` to avoid perturbing existing
# `src/**` type usage during the wrangler v3->v4 upgrade (see task-6-report.md
# for the wrangler upgrade rationale). That mismatch makes plain `npm install`
# / `npm ci` fail with ERESOLVE on a fresh clone.
legacy-peer-deps=true

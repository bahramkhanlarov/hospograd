{
  "name": "hospograd-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:next": "next dev",
    "build:next": "next build",
    "preview:next": "opennextjs-cloudflare build --config wrangler.next.jsonc && opennextjs-cloudflare preview --config wrangler.next.jsonc",
    "deploy:next": "opennextjs-cloudflare build --config wrangler.next.jsonc && opennextjs-cloudflare deploy --config wrangler.next.jsonc",
    "test": "vitest run",
    "deploy": "wrangler deploy --config wrangler.toml",
    "db:migrate:local": "wrangler d1 migrations apply hospograd --local",
    "db:migrate:remote": "wrangler d1 migrations apply hospograd --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.6.0",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.118.0"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.6.0",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
